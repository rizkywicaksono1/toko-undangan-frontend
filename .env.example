# Salin jadi ".env" untuk pengembangan lokal.
# Di Vercel, isi variabel ini lewat Project Settings > Environment Variables.

VITE_API_URL=https://nama-backend-anda.onrender.com/api
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
VITE_MIDTRANS_IS_PRODUCTION=false

# Opsional: isi untuk mengaktifkan tombol "Lanjutkan dengan Google" di halaman Masuk/Daftar.
# Ambil dari Google Cloud Console > APIs & Services > Credentials (OAuth Client ID, tipe "Web application").
# Kalau dikosongkan, tombol Google tidak muncul dan form daftar/masuk manual tetap berfungsi normal.
VITE_GOOGLE_CLIENT_ID=
